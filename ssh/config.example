# Copy this to your personal SSH config on your computer.
# Never commit a personalized copy or a private key.
#
# A NetID is the part before @msu.edu. For example, the email address
# AccountingRocks@msu.edu uses AccountingRocks as the SSH User value.

Host hpcc-gateway
    HostName hpcc.msu.edu
    User AccountingRocks
    IdentityFile ~/.ssh/msu_hpcc

Host hpcc-dev
    HostName dev-amd24
    User AccountingRocks
    IdentityFile ~/.ssh/msu_hpcc
    ProxyJump hpcc-gateway
